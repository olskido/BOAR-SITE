# ---------------------------------------------------------------------------
# $BOAR site configuration
# Copy this file to `.env.local` and fill in the real values.
# Every value here is OPTIONAL — the site ships with sensible defaults
# (see src/config/site.ts). Anything left blank simply hides that link.
# ---------------------------------------------------------------------------

# The $BOAR contract address (mint).
# Defaults to the address shown in the approved reference design.
NEXT_PUBLIC_BOAR_CA=CvhPmJe1BgQLcR3ncDgx2Q8Xg9iVT9wJxBxA1Jbjpump

# Where the "BUY $BOAR" button points.
# If left blank it is derived from the CA as https://pump.fun/coin/<CA>.
# Set this to your real buy/trade link to override.
NEXT_PUBLIC_BUY_URL=

# Your official X / Twitter URL (e.g. https://x.com/YourHandle).
# Leave blank to hide the X link in the footer. The hero "VIEW ON X"
# button falls back to https://x.com when this is not set.
NEXT_PUBLIC_X_URL=

# Telegram community invite URL. Leave blank to hide it in the footer.
NEXT_PUBLIC_TELEGRAM_URL=

# DexScreener URL. If left blank it is derived from the CA as
# https://dexscreener.com/solana/<CA>. Leave the CA blank too to hide it.
NEXT_PUBLIC_DEXSCREENER_URL=

# Absolute site URL, used for absolute OpenGraph/Twitter card image URLs.
NEXT_PUBLIC_SITE_URL=https://boar.example
